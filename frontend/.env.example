# ========================================
# AI Fruit Identification Assistant
# Frontend Environment Variables (Example)
# Copy this file to .env and fill in your values
# ========================================

# API Configuration
REACT_APP_API_URL=http://localhost:8000/api/v1
REACT_APP_WS_URL=ws://localhost:8000/ws
REACT_APP_API_TIMEOUT=30000

# App Configuration
REACT_APP_APP_NAME=AI Fruit Identification Assistant
REACT_APP_APP_VERSION=1.0.0
REACT_APP_ENV=development

# Feature Flags
REACT_APP_ENABLE_VOICE=true
REACT_APP_ENABLE_CHATBOT=true
REACT_APP_ENABLE_CAMERA=true
REACT_APP_ENABLE_OFFLINE_MODE=false
REACT_APP_ENABLE_PWA=true
REACT_APP_ENABLE_ANALYTICS=false

# File Upload
REACT_APP_MAX_FILE_SIZE_MB=10
REACT_APP_ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/webp
REACT_APP_IMAGE_COMPRESSION_QUALITY=0.8

# UI Configuration
REACT_APP_DEFAULT_THEME=light
REACT_APP_DEFAULT_LANGUAGE=en
REACT_APP_ITEMS_PER_PAGE=20

# Third-Party Services (Optional)
REACT_APP_GA_MEASUREMENT_ID=
REACT_APP_SENTRY_DSN=
REACT_APP_GOOGLE_MAPS_API_KEY=

# Development Settings
REACT_APP_DEBUG_MODE=true
REACT_APP_USE_MOCK_API=false

# Demo Mode
REACT_APP_DEMO_MODE=false