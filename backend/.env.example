# ========================================
# AI Fruit Identification Assistant
# Backend Environment Variables
# Copy this file to .env and fill in your values
# ========================================

# ========================================
# Application Configuration
# ========================================

# App Environment (development | production | staging)
APP_ENV=development
APP_NAME=AI Fruit Identification Assistant
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production

# Server Configuration
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# CORS - Allowed origins (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ========================================
# Database Configuration
# ========================================

# PostgreSQL (async)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/fruit_ai_db

# Database Pool
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis (for caching and Celery)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ========================================
# JWT Authentication
# ========================================

JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# File Upload Configuration
# ========================================

MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/jpg,image/png,image/webp
UPLOAD_DIR=./static/uploads
TEMP_DIR=./static/temp
EXPORT_DIR=./static/exports

# ========================================
# ML Model Configuration
# ========================================

ML_MODEL_PATH=./app/ml/models/fruit_classifier.h5
ML_MODEL_VERSION=2.3
ML_CONFIDENCE_THRESHOLD=0.6
ML_BATCH_SIZE=32

# Use mock ML model (no actual inference)
MOCK_ML_MODEL=True

# ========================================
# Celery (Background Tasks)
# ========================================

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ========================================
# Email Configuration (SMTP)
# ========================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@fruitai.com
SMTP_FROM_NAME=Fruit AI Assistant

# ========================================
# Cloud Storage (Optional)
# ========================================

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_REGION=us-east-1

# ========================================
# External APIs (Optional)
# ========================================

# Google Maps API
GOOGLE_MAPS_API_KEY=

# Nutrition API
NUTRITION_API_KEY=
NUTRITION_API_URL=https://api.nutritionix.com/v1_1

# ========================================
# Rate Limiting
# ========================================

RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ========================================
# Logging
# ========================================

LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ========================================
# Development Only
# ========================================

# Mock mode (no actual ML inference)
MOCK_ML_MODEL=True

# Demo mode (bypass auth)
DEMO_MODE=False

# Seed database with sample data
SEED_DATABASE=True

# App URL (for email links)
APP_URL=http://localhost:3000